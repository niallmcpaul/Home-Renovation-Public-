# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# The public https URL Tailscale Funnel gives you, e.g. https://yourmachine.your-tailnet.ts.net
PUBLIC_BASE_URL=https://change-me.ts.net

# Your PC's Tailscale IP (run `tailscale ip -4` on the host), used to bind the private listener
TAILSCALE_IP=100.x.x.x

# true once you're running over HTTPS (Tailscale Funnel/Cloudflare); keep false for local http-only testing
SECURE_COOKIES=false

# Optional: an rclone remote name (e.g. "onedrive:renovation-backups") to copy nightly backups off-machine
RCLONE_REMOTE=

DATA_DIR=/data
PRIVATE_HOST=0.0.0.0
PUBLIC_HOST=0.0.0.0
PRIVATE_PORT=8000
PUBLIC_PORT=8001
